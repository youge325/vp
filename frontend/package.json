{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "vue-tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.wdio.json",
    "lint": "eslint . --max-warnings 0",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:dead-code": "knip",
    "check:duplicates": "jscpd --config .jscpd.json",
    "check": "npm run lint && npm run test:typecheck && npm run check:architecture && npm run check:dead-code && npm run check:duplicates",
    "e2e": "node ./scripts/run-wdio.mjs",
    "e2e:ui": "node ./scripts/run-wdio.mjs --show --watch",
    "e2e:fixture": "node ./scripts/generate-e2e-fixture.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@vicons/ionicons5": "^0.13.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.32",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@wdio/cli": "^9.27.2",
    "@wdio/globals": "^9.27.2",
    "@wdio/local-runner": "^9.27.2",
    "@wdio/mocha-framework": "^9.27.2",
    "@wdio/spec-reporter": "^9.27.2",
    "brace-expansion": "file:./packages/brace-expansion-compat",
    "edgedriver": "^6.3.0",
    "esbuild": "^0.28.1",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "jscpd": "^5.0.14",
    "jsdom": "^27.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "knip": "^6.29.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "^8.0.16",
    "vite-plugin-istanbul": "^9.0.0",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.2.7",
    "webdriverio": "^9.27.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "cheerio": {
      "undici": "7.28.0"
    },
    "webdriver": {
      "undici": "6.27.0"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.0"
    },
    "brace-expansion": "$brace-expansion"
  }
}
