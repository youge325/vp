{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecodeConfig",
  "type": "object",
  "properties": {
    "mode": {
      "$ref": "#/$defs/DecodeMode"
    },
    "hwaccel": {
      "type": [
        "string",
        "null"
      ]
    },
    "hwaccelDevice": {
      "type": [
        "string",
        "null"
      ]
    },
    "decoder": {
      "type": [
        "string",
        "null"
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  },
  "required": [
