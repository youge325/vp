{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskErrorPayload",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "#/$defs/TaskErrorCode"
    },
    "message": {
      "type": "string"
    },
    "details": true
  },
  "required": [
    "code",
    "message"
  ],
  "$defs": {
    "TaskErrorCode": {
      "type": "string",
      "enum": [
        "missing_ffmpeg",
        "missing_model",
        "missing_tensor_backend",
        "missing_python_dependency",
        "cancelled",
        "process_failed",
        "spawn_failed",
        "runtime_panic",
        "invalid_input",
        "invalid_config",
        "resume_conflict",
        "io_error",
        "schema_mismatch",
        "persistence_failed"
      ]
    }
  }
}