{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutputConfig",
  "type": "object",
  "properties": {
    "outputDir": {
      "type": "string"
    },
    "openOnComplete": {
      "type": "boolean"
    },
    "segmentFrames": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "outputDir",
    "openOnComplete",
    "segmentFrames"
  ]
}