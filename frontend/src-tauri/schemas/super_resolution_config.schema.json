{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuperResolutionConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "scaleFactor": {
      "type": "number",
      "format": "double"
    },
    "algorithm": {
      "type": "string"
    },
    "onnxModel": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "enabled",
    "scaleFactor",
    "algorithm"
  ]
}