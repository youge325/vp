{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuperResolutionConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "scaleFactor": {
      "type": "number",
      "format": "double"
    },
    "algorithm": {
      "type": "string"
    },
    "onnxModel": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "tensorBackend": {
      "$ref": "#/$defs/TensorBackend",
      "default": "onnx"
    },
    "engine": {
      "type": "string",
      "default": "cuda"
    },
    "numFrames": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 10
    },
    "autoDownloadWeights": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "enabled",
    "scaleFactor",
    "algorithm"
  ],
  "$defs": {
    "TensorBackend": {
      "type": "string",
      "enum": [
        "pytorch",
        "paddle",
        "onnx"
      ]
    }
  }
}