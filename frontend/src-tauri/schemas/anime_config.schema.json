{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnimeConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "profile": {
      "type": "string"
    },
    "denoise": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "edgeBoost": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "enabled",
    "profile",
    "denoise",
    "edgeBoost"
  ]
}