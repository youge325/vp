{
  "$schema": "./ipc-manifest.schema.json",
  "schemaVersion": 6,
  "protocolConstants": {
    "terminalProgressPrefix": "[VP_PROGRESS]",
    "stageWorkerEventPrefix": "VP_STAGE_EVENT ",
    "tensorRtLogPrefix": "[VP_TRT]"
  },
  "protocolLimits": {
    "ndjsonLineBytes": 1048576,
    "oneShotStdoutBytes": 8388608,
    "stderrTailBytes": 65536,
    "errorSummaryBytes": 8192,
    "terminationReapMs": 5000
  },
  "backendProcessCommand": {
    "ipcCommand": "start_task",
    "subcommand": "process",
    "stdinPayload": "RuntimeConfigBundle",
    "stdinField": "config",
    "cliArguments": [
      { "flag": "--input", "field": "inputPath", "valueType": "string" },
      { "flag": "--config-stdin" },
      { "flag": "--resume-mode", "field": "resumeMode", "valueType": "ResumeMode", "optional": true }
    ],
    "eventPayload": "BackendTaskEnvelope",
    "discriminants": ["progress", "completed", "error", "resume_status"],
    "deadlines": {
      "stdinMs": 10000,
      "totalMs": null,
      "terminationReapLimit": "terminationReapMs"
    }
  },
  "backendTaskStream": [
    {
      "envelope": "progress",
      "payload": "TaskProgressPayload",
      "schemaRef": "./task-progress.schema.json"
    },
    {
      "envelope": "completed",
      "payload": "TaskCompletedPayload",
      "schemaRef": "./task-completed.schema.json"
    },
    {
      "envelope": "error",
      "payload": "BackendTaskErrorPayload",
      "schemaRef": "./backend-task-error.schema.json"
    },
    {
      "envelope": "resume_status",
      "payload": "ResumeStatusPayload",
      "schemaRef": "./resume-status.schema.json"
    }
  ],
  "backendOneShotCommands": [
    {
      "ipcCommand": "inspect_video",
      "subcommand": "info",
      "envelope": "info",
      "payload": "VideoInfo",
      "schemaRef": "./video-info.schema.json",
      "stdinPayload": null,
      "stdinField": null,
      "cliArguments": [
        { "flag": "--input", "field": "inputPath", "valueType": "string" }
      ],
      "deadlines": {
        "stdinMs": 10000,
        "totalMs": 30000,
        "terminationReapLimit": "terminationReapMs"
      }
    },
    {
      "ipcCommand": "check_environment",
      "subcommand": "check",
      "envelope": "check",
      "payload": "EnvironmentCheckResult",
      "schemaRef": "./environment.schema.json#/$defs/EnvironmentCheckResult",
      "stdinPayload": null,
      "stdinField": null,
      "cliArguments": [],
      "deadlines": {
        "stdinMs": 10000,
        "totalMs": 180000,
        "terminationReapLimit": "terminationReapMs"
      }
    },
    {
      "ipcCommand": "check_resume_state",
      "subcommand": "inspect-output",
      "envelope": "resume_inspection",
      "payload": "ResumeInspectionResult",
      "schemaRef": "./resume-inspection.schema.json",
      "stdinPayload": "RuntimeConfigBundle",
      "stdinField": "config",
      "cliArguments": [
        { "flag": "--input", "field": "inputPath", "valueType": "string" },
        { "flag": "--config-stdin" }
      ],
      "deadlines": {
        "stdinMs": 10000,
        "totalMs": 60000,
        "terminationReapLimit": "terminationReapMs"
      }
    }
  ],
  "stageWorkerCommand": {
    "command": ["-m", "app"],
    "subcommand": "stage-worker",
    "configFlag": "--config-json",
    "input": {
      "configPayload": "StageWorkerConfig",
      "stdinStream": "rawvideo-bytes"
    },
    "output": {
      "stdoutStream": "rawvideo-bytes",
      "stderrPayloads": ["StageWorkerProgressEvent", "StageWorkerErrorEvent"]
    },
    "deadlines": {
      "totalMs": null,
      "terminationReapLimit": "terminationReapMs"
    }
  },
  "commands": [
    { "name": "pick_inputs", "args": {}, "result": "string[]" },
    { "name": "pick_output_directory", "args": {}, "result": "string|null" },
    { "name": "check_environment", "args": { "forceRefresh": "boolean" }, "result": "EnvironmentCheckPayload" },
    { "name": "load_workbench_preset", "args": {}, "result": "WorkbenchPreset|null" },
    { "name": "save_workbench_preset", "args": { "preset": "WorkbenchPreset" }, "result": "void" },
    { "name": "inspect_video", "args": { "inputPath": "string" }, "result": "VideoInfo" },
    { "name": "check_resume_state", "args": { "request": "TaskRequest" }, "result": "ResumeInspectionResult" },
    { "name": "start_task", "args": { "request": "TaskRequest" }, "result": "void" },
    { "name": "control_task", "args": { "kind": "TaskControlKind" }, "result": "void" },
    { "name": "open_output_location", "args": { "path": "string" }, "result": "void" }
  ],
  "events": [
    { "name": "task-progress", "payload": "TaskProgressPayload" },
    { "name": "task-completed", "payload": "TaskCompletedPayload" },
    { "name": "task-error", "payload": "TaskErrorPayload" },
    { "name": "task-cancelled", "payload": "TaskCancelledPayload" },
    { "name": "task-log", "payload": "TaskLogPayload" },
    { "name": "task-resume-status", "payload": "ResumeStatusPayload" }
  ]
}
