{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RateControlConfig",
  "type": "object",
  "properties": {
    "mode": {
      "$ref": "#/$defs/RateControlMode"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ]
    }
  },
  "required": [
    "mode",
    "value"
  ],
  "$defs": {
    "RateControlMode": {
      "type": "string",
      "enum": [
        "crf",
        "cq",
        "qp",
        "bitrate"
      ]
    }
  },
  "additionalProperties": false
}
