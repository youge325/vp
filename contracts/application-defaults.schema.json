{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vp-workbench.local/contracts/application-defaults.schema.json",
  "title": "ApplicationDefaults",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "./application-defaults.schema.json"
    },
    "interpolation": {
      "$ref": "#/$defs/InterpolationDefaults"
    },
    "superResolution": {
      "$ref": "#/$defs/SuperResolutionDefaults"
    },
    "workflow": {
      "$ref": "#/$defs/WorkflowDefaults"
    },
    "output": {
      "$ref": "#/$defs/OutputDefaults"
    },
    "filters": {
      "$ref": "#/$defs/FilterDefaults"
    }
  },
  "required": [
    "$schema",
    "interpolation",
    "superResolution",
    "workflow",
    "output",
    "filters"
  ],
  "additionalProperties": false,
  "$defs": {
    "InterpolationDefaults": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "onnxModel": {
          "type": "string"
        },
        "targetFps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "multi": {
          "type": "integer",
          "minimum": 2
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fp16": {
          "type": "boolean"
        },
        "tensorBackend": {
          "$ref": "./tensor-backend.schema.json"
        },
        "engine": {
          "$ref": "./inference-engine.schema.json"
        }
      },
      "required": [
        "algorithm",
        "model",
        "onnxModel",
        "targetFps",
        "multi",
        "scale",
        "fp16",
        "tensorBackend",
        "engine"
      ],
      "additionalProperties": false
    },
    "SuperResolutionDefaults": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "onnxModel": {
          "type": "string"
        },
        "scaleFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "algorithm",
        "onnxModel",
        "scaleFactor"
      ],
      "additionalProperties": false
    },
    "WorkflowDefaults": {
      "type": "object",
      "properties": {
        "desktopFpsMode": {
          "$ref": "./workflow-config.schema.json#/$defs/FpsMode"
        },
        "cliFpsMode": {
          "$ref": "./workflow-config.schema.json#/$defs/FpsMode"
        },
        "processOrder": {
          "$ref": "./workflow-config.schema.json#/$defs/ProcessOrder"
        }
      },
      "required": [
        "desktopFpsMode",
        "cliFpsMode",
        "processOrder"
      ],
      "additionalProperties": false
    },
    "OutputDefaults": {
      "type": "object",
      "properties": {
        "segmentFrames": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "segmentFrames"
      ],
      "additionalProperties": false
    },
    "FilterDefaults": {
      "type": "object",
      "properties": {
        "scale": { "$ref": "#/$defs/ScaleFilterDefaults" },
        "crop": { "$ref": "#/$defs/CropFilterDefaults" },
        "pad": { "$ref": "#/$defs/PadFilterDefaults" },
        "sharpen": { "$ref": "#/$defs/SharpenFilterDefaults" },
        "denoise": { "$ref": "#/$defs/DenoiseFilterDefaults" },
        "color": { "$ref": "#/$defs/ColorFilterDefaults" },
        "animeCleanup": { "$ref": "#/$defs/AnimeCleanupDefaults" }
      },
      "required": ["scale", "crop", "pad", "sharpen", "denoise", "color", "animeCleanup"],
      "additionalProperties": false
    },
    "ScaleFilterDefaults": {
      "allOf": [
        { "$ref": "./filter-step.schema.json#/$defs/ScaleFilterParams" },
        { "required": ["mode", "factor", "width", "height", "interpolation"] }
      ]
    },
    "CropFilterDefaults": {
      "allOf": [
        { "$ref": "./filter-step.schema.json#/$defs/CropFilterParams" },
        { "required": ["x", "y", "width", "height"] }
      ]
    },
    "PadFilterDefaults": {
      "allOf": [
        { "$ref": "./filter-step.schema.json#/$defs/PadFilterParams" },
        { "required": ["top", "bottom", "left", "right", "color"] }
      ]
    },
    "SharpenFilterDefaults": {
      "allOf": [
        { "$ref": "./filter-step.schema.json#/$defs/SharpenFilterParams" },
        { "required": ["amount"] }
      ]
    },
    "DenoiseFilterDefaults": {
      "allOf": [
        { "$ref": "./filter-step.schema.json#/$defs/DenoiseFilterParams" },
        { "required": ["strength", "colorStrength"] }
      ]
    },
    "ColorFilterDefaults": {
      "allOf": [
        { "$ref": "./filter-step.schema.json#/$defs/ColorFilterParams" },
        { "required": ["brightness", "contrast", "saturation"] }
      ]
    },
    "AnimeCleanupStrengthDefaults": {
      "type": "object",
      "properties": {
        "denoise": { "$ref": "./filter-step.schema.json#/$defs/AnimeCleanupFilterParams/properties/denoise" },
        "edgeBoost": { "$ref": "./filter-step.schema.json#/$defs/AnimeCleanupFilterParams/properties/edgeBoost" }
      },
      "required": ["denoise", "edgeBoost"],
      "additionalProperties": false
    },
    "AnimeCleanupDefaults": {
      "type": "object",
      "properties": {
        "defaultProfile": {
          "$ref": "./filter-step.schema.json#/$defs/AnimeCleanupFilterParams/properties/profile"
        },
        "profiles": {
          "type": "object",
          "properties": {
            "clean-lines": { "$ref": "#/$defs/AnimeCleanupStrengthDefaults" },
            "thin-outline": { "$ref": "#/$defs/AnimeCleanupStrengthDefaults" },
            "balanced-cel": { "$ref": "#/$defs/AnimeCleanupStrengthDefaults" }
          },
          "required": ["clean-lines", "thin-outline", "balanced-cel"],
          "additionalProperties": false
        }
      },
      "required": ["defaultProfile", "profiles"],
      "additionalProperties": false
    }
  }
}
