{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterpolationConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "targetFps": {
      "type": "number",
      "format": "double",
      "exclusiveMinimum": 0
    },
    "multi": {
      "type": "integer",
      "format": "uint32",
      "minimum": 2
    },
    "algorithm": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "onnxModel": {
      "type": [
        "string",
        "null"
      ]
    },
    "scale": {
      "type": "number",
      "format": "double",
      "exclusiveMinimum": 0
    },
    "fp16": {
      "type": "boolean"
    },
    "tensorBackend": {
      "$ref": "#/$defs/TensorBackend"
    },
    "engine": {
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "targetFps",
    "multi",
    "algorithm",
    "model",
    "onnxModel",
    "scale",
    "fp16",
    "tensorBackend",
    "engine"
  ],
  "$defs": {
    "TensorBackend": {
      "type": "string",
      "enum": [
        "pytorch",
        "paddle",
        "onnx"
      ]
    }
  },
  "additionalProperties": false
}
