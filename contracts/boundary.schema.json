  "$defs": {
    "AlgorithmFamily": {
      "type": "string",
      "enum": [
        "rife",
        "onnx_super_resolution",
        "paddlegan_vsr"
      ]
    },
    "AlgorithmInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/AlgorithmFamily"
        },
        "tensorBackends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TensorBackend"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "onnxModels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modelDetails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelVariantInfo"
          }
        },
        "onnxModelDetails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelVariantInfo"
          }
        },
        "fixedScaleFactor": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "defaultNumFrames": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "inputFrameMode": {
          "$ref": "#/$defs/InputFrameMode"
        }
      },
      "required": [
        "name",
        "family",
        "tensorBackends",
        "models",
        "onnxModels",
        "modelDetails",
        "onnxModelDetails",
        "fixedScaleFactor",
        "defaultNumFrames",
        "inputFrameMode"
      ],
      "additionalProperties": false
    },
    "AnimeCleanupFilterParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "clean-lines",
            "thin-outline",
            "balanced-cel"
          ]
        },
        "denoise": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "edgeBoost": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "AnimeCleanupFilterStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "anime_cleanup"
        },
        "enabled": {
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/AnimeCleanupFilterParams"
        }
      },
      "required": [
        "kind",
        "enabled",
        "params"
      ]
    },
    "BackendTaskErrorCode": {
      "type": "string",
      "enum": [
        "missing_ffmpeg",
        "missing_model",
        "missing_tensor_backend",
        "missing_python_dependency",
        "cancelled",
        "process_failed",
        "invalid_input",
        "invalid_config",
        "resume_conflict",
        "io_error",
        "persistence_failed"
      ]
    },
    "BackendTaskErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/BackendTaskErrorCode"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "CapabilityChoice": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "CapabilityOptionKind": {
      "type": "string",
      "enum": [
        "boolean",
        "number",
        "string",
        "choice"
      ]
    },
    "CapabilityOptionSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/CapabilityOptionKind"
        },
        "defaultValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityChoice"
          }
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "name",
        "label",
        "type",
        "defaultValue",
        "choices",
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "CodecProfileFamily": {
      "type": "string",
      "enum": [
        "cpu",
        "nvidia",
        "intel",
        "software"
      ]
    },
    "CodecProfileSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/CodecProfileFamily"
        },
        "codec": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "hardwareDevices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityOptionSpec"
          }
        },
        "rateControlModes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/RateControlModeSpec"
          }
        },
        "hardwareDeviceOptions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/HardwareDeviceOptionSpec"
            }
          }
        }
      },
      "required": [
        "name",
        "label",
        "family",
        "codec",
        "available",
        "hardwareDevices",
        "options"
      ],
      "additionalProperties": false
    },
    "ColorFilterParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brightness": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "ColorFilterStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "color"
        },
        "enabled": {
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/ColorFilterParams"
        }
      },
      "required": [
        "kind",
        "enabled",
        "params"
      ]
    },
    "CropFilterParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "CropFilterStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "crop"
        },
        "enabled": {
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/CropFilterParams"
        }
      },
      "required": [
        "kind",
        "enabled",
        "params"
      ]
    },
    "DecodeConfig": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/DecodeMode"
        },
        "hwaccel": {
          "type": [
            "string",
            "null"
          ]
        },
        "hwaccelDevice": {
          "type": [
            "string",
            "null"
          ]
        },
        "decoder": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "required": [
        "mode",
        "hwaccel",
        "hwaccelDevice",
        "decoder",
        "options"
      ],
      "additionalProperties": false
    },
    "DecodeMode": {
      "type": "string",
      "enum": [
        "software",
        "hardware"
      ]
    },
    "DenoiseFilterParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "colorStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "DenoiseFilterStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "denoise"
        },
        "enabled": {
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/DenoiseFilterParams"
        }
      },
      "required": [
        "kind",
        "enabled",
        "params"
      ]
    },
    "EncodeConfig": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "keepAudio": {
          "type": "boolean"
        },
        "rateControl": {
          "$ref": "#/$defs/RateControlConfig"
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "required": [
        "codec",
        "family",
        "container",
        "keepAudio",
        "rateControl",
        "options"
      ],
      "additionalProperties": false
    },
    "EnvironmentCacheEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "checkedAt",
        "fingerprint",
        "result"
      ],
      "properties": {
        "schemaVersion": {
          "const": 14
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "#/$defs/EnvironmentCheckResult"
        }
      }
    },
    "EnvironmentCheckPayload": {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/EnvironmentCheckResult"
        },
        "source": {
          "$ref": "#/$defs/EnvironmentCheckSource"
        },
        "checkedAt": {
          "type": "string"
        }
      },
      "required": [
        "result",
        "source",
        "checkedAt"
      ],
      "additionalProperties": false
    },
    "EnvironmentCheckResult": {
      "type": "object",
      "properties": {
        "ffmpeg": {
          "$ref": "#/$defs/FfmpegInfo"
        },
        "gpu": {
          "$ref": "#/$defs/GpuInfo"
        },
        "tensorEngines": {
          "$ref": "#/$defs/TensorEngines"
        },
        "interpolationAlgorithms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlgorithmInfo"
          }
        },
        "superResolutionAlgorithms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlgorithmInfo"
          }
        },
        "runtimeMode": {
          "$ref": "#/$defs/RuntimeMode"
        }
      },
      "required": [
        "ffmpeg",
        "gpu",
        "tensorEngines",
        "interpolationAlgorithms",
        "superResolutionAlgorithms",
        "runtimeMode"
      ],
      "additionalProperties": false
    },
    "EnvironmentCheckSource": {
      "type": "string",
      "enum": [
        "cache",
        "probe"
      ]
    },
    "FfmpegInfo": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "hwaccels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "encoderProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodecProfileSpec"
          }
        },
        "decoderProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodecProfileSpec"
          }
        }
      },
      "required": [
        "available",
        "hwaccels",
        "encoderProfiles",
        "decoderProfiles"
      ],
      "additionalProperties": false
    },
    "FilterPipelineConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FilterStep"
          }
        }
      },
      "required": [
        "enabled",
        "filters"
      ],
      "additionalProperties": false
    },
    "FilterStep": {
      "oneOf": [
        {
          "$ref": "#/$defs/ScaleFilterStep"
        },
        {
          "$ref": "#/$defs/CropFilterStep"
        },
        {
          "$ref": "#/$defs/PadFilterStep"
        },
        {
          "$ref": "#/$defs/SharpenFilterStep"
        },
        {
          "$ref": "#/$defs/DenoiseFilterStep"
        },
