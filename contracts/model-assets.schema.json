{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vp-workbench.local/contracts/model-assets.schema.json",
  "title": "VP Workbench model assets",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "license", "runtime", "families"],
  "properties": {
    "$schema": { "const": "./model-assets.schema.json" },
    "license": { "$ref": "#/$defs/ModelLicense" },
    "runtime": { "$ref": "#/$defs/ModelRuntime" },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ModelAssetFamily" }
    }
  },
  "$defs": {
    "ModelLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdxId",
        "usage",
        "sourceUrl",
        "licenseRelativePath",
        "noticeRelativePath",
        "thirdPartyNoticeRelativePath"
      ],
      "properties": {
        "spdxId": { "const": "CC-BY-NC-SA-4.0" },
        "usage": { "const": "non_commercial" },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "licenseRelativePath": { "const": "licenses/real-rawvsr/CC-BY-NC-SA-4.0.txt" },
        "noticeRelativePath": { "const": "licenses/real-rawvsr/NOTICE.md" },
        "thirdPartyNoticeRelativePath": { "const": "licenses/real-rawvsr/THIRD-PARTY-NOTICES.md" }
      }
    },
    "ModelRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithmFamily", "tensorBackend", "engines"],
      "properties": {
        "algorithmFamily": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "tensorBackend": { "$ref": "./tensor-backend.schema.json" },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "./inference-engine.schema.json" }
        }
      }
    },
    "SpatialPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumSize", "sizeMultiple"],
      "properties": {
        "minimumSize": { "type": "integer", "minimum": 1 },
        "sizeMultiple": { "type": "integer", "minimum": 1 }
      }
    },
    "UpstreamCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folder", "sourceStem"],
      "properties": {
        "folder": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
        "sourceStem": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9_-]+$" }
      }
    },
    "ModelAssetVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scaleFactor",
        "googleDriveFileId",
        "sourceBytes",
        "sourceSha256",
        "inferenceBytes",
        "inferenceSha256",
        "parameterCount",
        "relativePath"
      ],
      "properties": {
        "scaleFactor": { "type": "integer", "minimum": 1 },
        "googleDriveFileId": { "type": "string", "minLength": 10, "pattern": "^[A-Za-z0-9_-]+$" },
        "sourceBytes": { "type": "integer", "minimum": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "inferenceBytes": { "type": "integer", "minimum": 1 },
        "inferenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "parameterCount": { "type": "integer", "minimum": 1 },
        "relativePath": {
          "type": "string",
          "pattern": "^models/super_resolution/pytorch/[a-z0-9-]+/x[1-9][0-9]*/model\\.safetensors$"
        }
      }
    },
    "ModelAssetFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmId",
        "displayName",
        "implementationKey",
        "inputFrameMode",
        "defaultNumFrames",
        "temporalContextFrames",
        "spatialPolicy",
        "runtimeRequirements",
        "upstreamCheckpoint",
        "variants"
      ],
      "properties": {
        "algorithmId": { "type": "string", "pattern": "^real-rawvsr-[a-z0-9-]+$" },
        "displayName": { "type": "string", "minLength": 1 },
        "implementationKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "inputFrameMode": { "enum": ["editable_chunk", "fixed_window"] },
        "defaultNumFrames": { "type": "integer", "minimum": 1 },
        "temporalContextFrames": { "type": "integer", "minimum": 0 },
        "spatialPolicy": { "$ref": "#/$defs/SpatialPolicy" },
        "runtimeRequirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["torchvision_deform_conv"] }
        },
        "upstreamCheckpoint": { "$ref": "#/$defs/UpstreamCheckpoint" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ModelAssetVariant" }
        }
      }
    }
  }
}
