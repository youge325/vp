{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vp-workbench.local/contracts/model-assets.schema.json",
  "title": "VP Workbench model assets",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "license", "families"],
  "properties": {
    "$schema": { "const": "./model-assets.schema.json" },
    "license": { "$ref": "#/$defs/ModelLicense" },
    "families": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/ModelAssetFamily" }
    }
  },
  "$defs": {
    "ModelLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdxId",
        "usage",
        "sourceUrl",
        "licenseRelativePath",
        "noticeRelativePath",
        "thirdPartyNoticeRelativePath"
      ],
      "properties": {
        "spdxId": { "const": "CC-BY-NC-SA-4.0" },
        "usage": { "const": "non_commercial" },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "licenseRelativePath": { "const": "licenses/real-rawvsr/CC-BY-NC-SA-4.0.txt" },
        "noticeRelativePath": { "const": "licenses/real-rawvsr/NOTICE.md" },
        "thirdPartyNoticeRelativePath": { "const": "licenses/real-rawvsr/THIRD-PARTY-NOTICES.md" }
      }
    },
    "ModelAssetVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scaleFactor",
        "googleDriveFileId",
        "sourceBytes",
        "sourceSha256",
        "inferenceBytes",
        "inferenceSha256",
        "parameterCount",
        "relativePath"
      ],
      "properties": {
        "scaleFactor": { "type": "integer", "enum": [2, 3, 4] },
        "googleDriveFileId": { "type": "string", "minLength": 10, "pattern": "^[A-Za-z0-9_-]+$" },
        "sourceBytes": { "type": "integer", "minimum": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "inferenceBytes": { "type": "integer", "minimum": 1 },
        "inferenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "parameterCount": { "type": "integer", "minimum": 1 },
        "relativePath": {
          "type": "string",
          "pattern": "^models/super_resolution/pytorch/real-rawvsr-(basicvsr|edvr|tdan|toflow)/x[234]/model\\.safetensors$"
        }
      }
    },
    "ModelAssetFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmId",
        "family",
        "displayName",
        "inputFrameMode",
        "defaultNumFrames",
        "temporalContextFrames",
        "variants"
      ],
      "properties": {
        "algorithmId": {
          "enum": [
            "real-rawvsr-basicvsr",
            "real-rawvsr-edvr",
            "real-rawvsr-tdan",
            "real-rawvsr-toflow"
          ]
        },
        "family": { "const": "pytorch_vsr" },
        "displayName": { "type": "string", "minLength": 1 },
        "inputFrameMode": { "enum": ["editable_chunk", "fixed_window"] },
        "defaultNumFrames": { "type": "integer", "minimum": 1 },
        "temporalContextFrames": { "const": 2 },
        "variants": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/ModelAssetVariant" }
        }
      }
    }
  }
}
